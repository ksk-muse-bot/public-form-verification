# EditorConfig（https://editorconfig.org）
# エディタを問わず共通の最小整形ルール。言語固有の整形は各言語の
# フォーマッタ（ruff、gofmt、rustfmt など）が正で、これは土台。

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[Makefile]
indent_style = tab
