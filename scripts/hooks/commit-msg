#!/bin/sh
# commit-msg フック: コミットメッセージの形式と秘密情報の混入を検証する
#
# 規約（Conventional Commits、私たちの様式）:
#   <type>: <要約>
#   - type は feat / fix / docs / chore / refactor / test / ci のいずれか
#   - type の後に (scope) と !（破壊的変更の印）を付けてもよい
#   - 要約は72文字以内で、末尾に「.」や「。」を付けない
#   - type 以外（要約と本文）は日本語で書く
# マージコミット（1行目が "Merge " で始まるもの）は形式チェックの対象外。
# 秘密情報のチェックはマージコミットを含む全メッセージが対象。
# パターンの正本は muse-workspace の data/secret-patterns.json で、このフックの
# パターンは同リポジトリの生成スクリプトが正本から生成する（下の GENERATED ブロック）。
#
# このフックは scripts/install-hooks.sh で .git/hooks/ へ導入される。

set -u

msg_file=$1
first_line=$(head -n 1 "$msg_file")

# 秘密情報の混入チェック（メッセージ全体が対象）
# コミットメッセージは履歴に残り続けるため、秘密を書いた時点で漏洩になる
# === BEGIN GENERATED SECRET PATTERNS ===
# 正本: muse-workspace の data/secret-patterns.json。
# 生成: 同リポジトリの scripts/generate_secret_patterns.py。手で編集しないこと。
if grep -Eq -- '-----BEGIN (RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|glpat-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}' "$msg_file"; then
# === END GENERATED SECRET PATTERNS ===
    cat >&2 <<'EOF'
commit-msg: コミットメッセージに秘密情報らしき文字列が含まれています。

秘密情報（API キー、トークン、秘密鍵など）は、ファイルの中身だけでなく
コミットメッセージにも絶対に書かないでください。メッセージは履歴に
残り続け、後から消すことはできません。
漏れてしまった場合は、履歴の書き換えではなく、対象の秘密を
失効・再発行することが前提です。
EOF
    exit 1
fi

explain() {
    cat >&2 <<EOF
commit-msg: コミットメッセージの1行目が規約に合いません。

  受け取った1行目: $first_line

  形式: <type>: <要約>
    type: feat / fix / docs / chore / refactor / test / ci
          （任意で (scope) と ! を付けられる。例: feat(api)!: ...）
    要約: 72文字以内で、末尾に「.」や「。」を付けない

  例: feat: ユーザー登録 API を追加
      fix(parser): 空行だけの入力で落ちる問題を修正
EOF
}

# マージコミットは対象外
case $first_line in
    "Merge "*) exit 0 ;;
esac

# 「<prefix>: <要約>」の形になっているか
case $first_line in
    *": "*) ;;
    *)
        explain
        exit 1
        ;;
esac

prefix=${first_line%%: *}
summary=${first_line#*: }

# prefix から末尾の ! と (scope) を取り除き、type だけを残す
type_part=$prefix
case $type_part in
    *"!") type_part=${type_part%?} ;;
esac
case $type_part in
    *"("*")") type_part=${type_part%%"("*} ;;
esac

case $type_part in
    feat | fix | docs | chore | refactor | test | ci) ;;
    *)
        explain
        exit 1
        ;;
esac

# scope が空（"()" の形）のは不可
case $prefix in
    *"()"*)
        explain
        exit 1
        ;;
esac

# 要約が空は不可
if [ -z "$summary" ]; then
    explain
    exit 1
fi

# 要約は72文字以内（数えるのはバイト数ではなく文字数）
# wc -m はロケールが POSIX / C の環境ではバイト数を返してしまうため、
# python3 がある環境では UTF-8 として数え、無い場合だけ wc -m にフォールバックする
if command -v python3 >/dev/null 2>&1; then
    summary_len=$(printf '%s' "$summary" | python3 -c 'import sys; print(len(sys.stdin.buffer.read().decode("utf-8")))')
else
    summary_len=$(printf '%s' "$summary" | wc -m | tr -d ' ')
fi
if [ "$summary_len" -gt 72 ]; then
    echo "commit-msg: 要約が72文字を超えています（${summary_len}文字）" >&2
    explain
    exit 1
fi

# 要約の末尾に「.」や「。」を付けない
case $summary in
    *"." | *"。")
        explain
        exit 1
        ;;
esac

exit 0
